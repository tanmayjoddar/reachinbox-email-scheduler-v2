PORT=3000
NODE_ENV=development
DATABASE_URL=postgresql://user:password@ep-your-project-pooler.region.aws.neon.tech/outbox?sslmode=verify-full
# Local docker compose instead: postgres://postgres:postgres@localhost:55432/outbox
REDIS_URL=redis://localhost:6379
JWT_SECRET=change-me-dev-secret
WORKER_CONCURRENCY=5
MIN_DELAY_MS=2000
MAX_EMAILS_PER_HOUR_PER_SENDER=200
LOG_LEVEL=info
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
BASE_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173
ELASTICSEARCH_URL=http://localhost:9200
SLACK_CLIENT_ID=your-slack-client-id
SLACK_CLIENT_SECRET=your-slack-client-secret
SLACK_REDIRECT_URL=https://your-tunnel.example.com/slack/callback
ADMIN_USER=admin
ADMIN_PASS=change-me
# USER_ID=<id column from the make-token dev user; only used by npm run load-test>

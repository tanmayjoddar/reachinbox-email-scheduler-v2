{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "outbox-scheduler-frontend",
  "compatibility_date": "2024-11-01",
  "main": "worker.js",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS"
  },
  "vars": {
    "BACKEND_URL": "https://reachinbox-email-scheduler-cbg6.onrender.com"
  },
  "triggers": {
    "crons": ["*/10 * * * *"]
  }
}
